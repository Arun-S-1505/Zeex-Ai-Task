NODE_ENV=development
PORT=3001
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sentinel_ai?schema=public"
JWT_SECRET=dev-jwt-secret-key-minimum-32-characters-long-here-sentinel
JWT_REFRESH_SECRET=dev-refresh-secret-key-minimum-32-characters-long-here-sentinel
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:5173
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads
LOG_LEVEL=debug
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

